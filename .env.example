# Copy to .env and fill in. No secrets in git.

# Supabase: Project Settings → Database → URI (prefer Session pooler, port 5432)
# Append ?sslmode=require for Supabase.
# Local docker-compose workaround (no Supabase needed for dev):
# DATABASE_URL=postgresql://postgres:talktodb@127.0.0.1:54329/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Groq console → API Keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

EMBEDDING_MODEL=all-mpnet-base-v2
TOP_K=5
